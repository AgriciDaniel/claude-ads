{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-marketing-hub:claude-ads:schema:core:v1:cockpit-action-receipt.schema.json",
  "title": "cockpit-action-receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "action_id",
    "run_id",
    "operation",
    "started_at",
    "finished_at",
    "outcome",
    "input_fingerprint",
    "policy_fingerprint",
    "outputs",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "cockpit-action-receipt"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "operation": {
      "enum": [
        "validate-input",
        "validate-run",
        "render-report"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_-][A-Za-z0-9._/-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    }
  }
}
